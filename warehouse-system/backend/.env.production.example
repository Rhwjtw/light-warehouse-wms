APP_NAME=轻量级仓库管理与生产领料系统
APP_ENV=production
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=warehouse_production
MYSQL_USER=warehouse_app
MYSQL_PASSWORD=
MYSQL_MIGRATION_USER=warehouse_migrator
MYSQL_MIGRATION_PASSWORD=
# 仅首次执行 bootstrap_mysql.py 使用；成功后必须保持为空。
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
# 仅首次执行 init_admin.py 使用；脚本成功后自动清空密码。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
INITIAL_ADMIN_PASSWORD=
# 正式同源部署不依赖 CORS；确需跨域时只填明确的 https://来源。
CORS_ORIGINS=[]
BUSINESS_TIMEZONE=Asia/Shanghai
AUTH_SECRET=
AUTH_TOKEN_HOURS=8
API_DOCS_ENABLED=false
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist
LOG_LEVEL=INFO
WEB_HOST=0.0.0.0
WEB_PORT=80
WEB_WORKERS=1
