{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "production_file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "default",
      "filename": "../.runtime/production/logs/backend.log",
      "when": "midnight",
      "backupCount": 30,
      "encoding": "utf-8"
    }
  },
  "root": {
    "handlers": ["production_file"],
    "level": "INFO"
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["production_file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["production_file"],
      "level": "INFO",
      "propagate": false
    },
    "warehouse": {
      "handlers": ["production_file"],
      "level": "INFO",
      "propagate": false
    }
  }
}
