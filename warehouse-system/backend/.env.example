APP_NAME=轻量级仓库管理与生产领料系统
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=warehouse_system
MYSQL_USER=warehouse_app
MYSQL_PASSWORD=
MYSQL_MIGRATION_USER=warehouse_migrator
MYSQL_MIGRATION_PASSWORD=
# 仅供 scripts/bootstrap_mysql.py 首次初始化；运行后可清空管理员信息。
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
BUSINESS_TIMEZONE=Asia/Shanghai
AUTH_SECRET=
AUTH_TOKEN_HOURS=8
API_DOCS_ENABLED=true
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist
LOG_LEVEL=INFO

# 仅由 start-prod.ps1 读取；开发启动脚本不使用这些值。
WEB_HOST=0.0.0.0
WEB_PORT=80
WEB_WORKERS=1
